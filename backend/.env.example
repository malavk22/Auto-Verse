# Copy this file to .env and fill in your own values
# Example for SQL Server with Windows Trusted Connection:
DATABASE_URL=mssql+pyodbc://<server>/<database>?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# Secret used to sign login tokens (JWT) — set this to a long random string.
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<a-long-random-string>

# Used to send "forgot password" reset link emails via Resend (free tier,
# HTTPS-based - unlike SMTP this isn't blocked on hosts that block outbound
# SMTP ports). Sign up at https://resend.com and create an API key.
# If left blank, reset emails are skipped (logged to the backend console instead).
RESEND_API_KEY=<your-resend-api-key>
# Default sender uses Resend's shared test domain - fine until you verify
# your own domain with Resend, at which point you can send from your own address.
RESEND_FROM_EMAIL=AutoVerse <onboarding@resend.dev>

# Base URL of the running frontend — used to build the reset-password link.
FRONTEND_URL=http://localhost:5173

