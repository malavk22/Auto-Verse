# Copy this file to .env and fill in your own values
# Example for SQL Server with Windows Trusted Connection:
DATABASE_URL=mssql+pyodbc://<server>/<database>?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

# Secret used to sign login tokens (JWT) — set this to a long random string.
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<a-long-random-string>

# Used to send "forgot password" reset link emails via Gmail SMTP (free).
# 1. Turn on 2-Step Verification on the Gmail account you want to send from:
#    https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Put that Gmail address and the 16-character app password below.
# If left blank, reset emails are skipped (logged to the backend console instead).
SMTP_EMAIL=<your-gmail-address>
SMTP_APP_PASSWORD=<your-16-char-app-password>

# Base URL of the running frontend — used to build the reset-password link.
FRONTEND_URL=http://localhost:5173

